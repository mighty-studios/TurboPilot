<ctl:TurbolandFloatingDialog
	x:Class="TurboPilot.Dialogs.CustomizeDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls;assembly=TurbolandTheme.Wpf"
	Title="Customization">

	<!-- Edit the ordered list of folders the application searches for
	customization items (agents, skills and instructions). Order matters:
	later entries override earlier ones. The floating dialog sizes to its
	content, so the fixed width on the root panel is what sets the dialog
	width. The found-items tree, details pane, filter and Add To Prompt
	are placeholders until the folder scan is implemented. -->
	<StackPanel Width="460">
		<Label Content="Search Paths For Agents, Skills and Instructions:"/>

		<!-- Folder list with its side button column. -->
		<Grid Margin="0,4,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<ListBox x:Name="listBox" Grid.Column="0" Height="112"
					SelectionMode="Single"
					SelectionChanged="OnListSelectionChanged"
					Margin="{DynamicResource Turboland.Size.ColumnGutter}"/>

			<StackPanel Grid.Column="1" Width="96">
				<Button x:Name="buttonAdd" Content="Add" Click="OnAdd"
						Margin="0,0,0,6"/>
				<Button x:Name="buttonDelete" Content="Delete" Click="OnDelete"
						Margin="0,0,0,6"/>
				<Button x:Name="buttonMoveUp" Content="Move Up" Click="OnMoveUp"
						Margin="0,0,0,6"/>
				<Button x:Name="buttonMoveDown" Content="Move Down" Click="OnMoveDown"/>
			</StackPanel>
		</Grid>

		<!-- Placeholders: populated once the search paths are scanned. -->
		<Grid Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="250"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0" Margin="{DynamicResource Turboland.Size.ColumnGutter}">
				<Label Content="Items Found"/>
				<TreeView x:Name="treeView" Height="160" IsEnabled="False"/>
			</StackPanel>
			<StackPanel Grid.Column="1">
				<Label Content="Item Details"/>
				<TextBox x:Name="textBoxDetails" Height="160" TextWrapping="Wrap"
						IsEnabled="False" VerticalScrollBarVisibility="Auto"/>
			</StackPanel>
		</Grid>

		<Grid Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<RadioButton x:Name="radioOnlyEnabled" Content="Only Show Enabled"
						IsEnabled="False" VerticalAlignment="Center"/>
				<Button x:Name="buttonAddToPrompt" Content="Add To Prompt" Width="120"
						Margin="16,0,0,0" IsEnabled="False"/>
			</StackPanel>
			<!-- ButtonStripMargin keeps each button's hard shadow off its
			neighbor; the rightmost button needs none. -->
			<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="buttonOK" Content="OK" IsDefault="True" Click="OnOk"
						Margin="{DynamicResource Turboland.Size.ButtonStripMargin}"/>
				<Button x:Name="buttonCancel" Content="Cancel" IsCancel="True" Click="OnCancel"/>
			</StackPanel>
		</Grid>
	</StackPanel>
</ctl:TurbolandFloatingDialog>

<ctl:TurbolandFloatingDialog x:Class="TurboPilot.Dialogs.MediatorDialog"
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls;assembly=TurbolandTheme.Wpf"
					Title="MEDIATOR SETTINGS" MinWidth="760" MaxWidth="960">
	<StackPanel Margin="10">
		<CheckBox x:Name="checkEnabled" Content="Enable local Mediator"
				Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
		<GroupBox Header="On-device model" Margin="0,10,0,0">
			<StackPanel>
				<ComboBox x:Name="comboModel" DisplayMemberPath="Alias"
						SelectionChanged="OnModelChanged" MinWidth="710"/>
				<TextBlock x:Name="textModelDetails" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="710"/>
				<StackPanel Orientation="Horizontal" Margin="0,10,0,0">
					<Button x:Name="buttonQuery" Content="Refresh Models" Click="OnQuery" Margin="0,0,10,0"/>
					<Button x:Name="buttonAcceleration" Content="Prepare Acceleration" Click="OnAcceleration" Margin="0,0,10,0"/>
					<Button x:Name="buttonDownload" Content="Download Model" Click="OnDownload" Margin="0,0,10,0"/>
					<Button x:Name="buttonStop" Content="Stop" Click="OnStop"/>
				</StackPanel>
				<TextBlock Margin="0,8,0,0" MaxWidth="710" TextWrapping="Wrap"
						Text="CPU models are available immediately. Prepare Acceleration downloads GPU/NPU support available for this device."/>
			</StackPanel>
		</GroupBox>
		<GroupBox Header="Options" Margin="0,10,0,0">
			<StackPanel>
				<TextBlock TextWrapping="Wrap" MaxWidth="710"
						Text="The Mediator is parked for a future purpose. When enabled, it records prompts, answers, replies, and tool results in a local worklog. It never changes what is sent or shown."/>
				<CheckBox x:Name="checkDebug" Content="Show Mediator diagnostics in Raw only" Margin="0,8,0,0"
						ToolTip="Show local model requests and responses without sending them to the session model or Rendered output."/>
			</StackPanel>
		</GroupBox>
		<TextBlock x:Name="textStatus" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="710"/>
		<TextBlock Text="Options apply on OK. Downloads are kept."
				Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="710"/>
		<Grid Margin="0,16,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<Button Content="Open Configuration Folder" HorizontalAlignment="Left" Click="OnOpenFolder"/>
			<StackPanel Grid.Column="1" Orientation="Horizontal">
				<Button Content="Cancel" IsCancel="True" Click="OnCancel" Margin="0,0,12,0"/>
				<Button x:Name="buttonOk" Content="OK" IsDefault="True" Click="OnOk" MinWidth="96"/>
			</StackPanel>
		</Grid>
	</StackPanel>
</ctl:TurbolandFloatingDialog>

<ctl:TurbolandFloatingDialog x:Class="TurboPilot.Dialogs.ChooseFolderDialog"
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls;assembly=TurbolandTheme.Wpf"
					Title="NEW SESSION"
					Width="440">

	<!-- The New Session dialog: workspace folder path input with Browse button,
	     and Cancel/OK buttons. A fixed Width keeps the path field comfortably
	     wide; the floating dialog sizes its height to this content. -->

	<StackPanel>
		<!-- Workspace folder label -->
		<TextBlock Text="Workspace folder:"
				   Margin="12,8,12,4"
				   Foreground="{DynamicResource Turboland.Brush.WindowForeground}"
				   FontFamily="{DynamicResource Turboland.Font.Primary}"
				   FontSize="{DynamicResource Turboland.Font.Size.Primary}"/>

		<!-- Path input + Browse button row -->
		<Grid Margin="12,0,12,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBox x:Name="textBoxWorkspacePath"
					 MinWidth="200"
					 Background="{DynamicResource Turboland.Brush.FieldBackground}"
					 Foreground="{DynamicResource Turboland.Brush.FieldForeground}"
					 FontFamily="{DynamicResource Turboland.Font.Primary}"
					 FontSize="{DynamicResource Turboland.Font.Size.Primary}"
					 BorderBrush="{DynamicResource Turboland.Brush.ControlShadow}"
					 HorizontalContentAlignment="Left"/>

			<Button x:Name="buttonBrowse"
					Grid.Column="1"
					Content="Browse"
					Width="80"
					Height="28"
					Margin="8,0,0,0"
					Background="{DynamicResource Turboland.Brush.ButtonFace}"
					Foreground="{DynamicResource Turboland.Brush.ButtonForeground}"
					FontFamily="{DynamicResource Turboland.Font.Primary}"
					FontSize="{DynamicResource Turboland.Font.Size.Primary}"
					BorderBrush="{DynamicResource Turboland.Brush.ControlShadow}"
					Click="OnBrowse"/>
		</Grid>

		<!-- Button panel -->
		<StackPanel Orientation="Horizontal"
					HorizontalAlignment="Right"
					Margin="12,8,12,12"
					FlowDirection="RightToLeft">
			<Button x:Name="buttonOk"
					Content="OK"
					Width="80"
					Height="28"
					Margin="0,0,8,0"
					Background="{DynamicResource Turboland.Brush.ButtonFace}"
					Foreground="{DynamicResource Turboland.Brush.ButtonForeground}"
					FontFamily="{DynamicResource Turboland.Font.Primary}"
					FontSize="{DynamicResource Turboland.Font.Size.Primary}"
					BorderBrush="{DynamicResource Turboland.Brush.ControlShadow}"
					IsDefault="True"
					Click="OnOk"/>
			<Button x:Name="buttonCancel"
					Content="Cancel"
					Width="80"
					Height="28"
					Margin="0,0,8,0"
					Background="{DynamicResource Turboland.Brush.ButtonFace}"
					Foreground="{DynamicResource Turboland.Brush.ButtonForeground}"
					FontFamily="{DynamicResource Turboland.Font.Primary}"
					FontSize="{DynamicResource Turboland.Font.Size.Primary}"
					BorderBrush="{DynamicResource Turboland.Brush.ControlShadow}"
					IsCancel="True"
					Click="OnCancel"/>
		</StackPanel>
	</StackPanel>
</ctl:TurbolandFloatingDialog>

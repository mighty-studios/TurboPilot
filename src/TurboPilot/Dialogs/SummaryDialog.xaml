<ctl:TurbolandFloatingDialog x:Class="TurboPilot.Dialogs.SummaryDialog"
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls;assembly=TurbolandTheme.Wpf"
					Title="MEDIATOR SUMMARY" MinWidth="720">
	<StackPanel Margin="10">
		<TextBox x:Name="textSummary" Width="690" Height="380" IsReadOnly="True"
				TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Copy" Click="OnCopy" Margin="0,0,12,0"/>
			<Button Content="Close" IsCancel="True" IsDefault="True" Click="OnClose"/>
		</StackPanel>
	</StackPanel>
</ctl:TurbolandFloatingDialog>

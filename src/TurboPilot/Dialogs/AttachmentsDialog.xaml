<ctl:TurbolandFloatingDialog x:Class="TurboPilot.Dialogs.AttachmentsDialog"
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls;assembly=TurbolandTheme.Wpf"
					Title="Attachments" Width="560" Height="270">

	<!-- The files riding along with the next prompt. The list shows every
	     attachment by full path; Add opens a file picker (multiple
	     selection allowed) and Remove drops the selected entry. Edits
	     happen on the dialog's own copy: OK hands the finished list back,
	     Cancel and the close box discard it. -->
	<StackPanel Margin="10">
		<Label Content="Files attached to the next prompt"/>

		<!-- List with its side button column, laid out like the folder
		     list in the Customization dialog. -->
		<Grid Margin="0,4,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<ListBox x:Name="listBox" Grid.Column="0" Height="140"
						SelectionMode="Single"
						HorizontalContentAlignment="Left"
						ScrollViewer.HorizontalScrollBarVisibility="Auto"
						SelectionChanged="OnListSelectionChanged"
						Margin="{DynamicResource Turboland.Size.ColumnGutter}"/>

			<StackPanel Grid.Column="1" Width="96">
				<Button x:Name="buttonAdd" Content="Add" Click="OnAdd"
						Margin="0,0,0,6"/>
				<Button x:Name="buttonRemove" Content="Remove" Click="OnRemove"/>
			</StackPanel>
		</Grid>

		<!-- ButtonStripMargin keeps each button's hard shadow off its
		     neighbor; the rightmost button needs none. -->
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
			<Button x:Name="buttonCancel" Content="Cancel" Width="100" IsCancel="True" Click="OnCancel" Margin="0,0,12,0"/>
			<Button x:Name="buttonOK" Content="OK" Width="100" IsDefault="True" Click="OnOk"
					Margin="{DynamicResource Turboland.Size.ButtonStripMargin}"/>
		</StackPanel>
	</StackPanel>
</ctl:TurbolandFloatingDialog>

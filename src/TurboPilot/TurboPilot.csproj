<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- net9.0-windows10.0.18362.0 (Win10 18362+) is required by the
		     Microsoft.AI.Foundry.Local.WinML package (net8.0-windows10.0.18362)
		     used for the Mediator's on-device local model. -->
		<TargetFramework>net9.0-windows10.0.18362.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>TurboPilot</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<PropertyGroup>
		<!-- The Foundry Local WinML package requires a RuntimeIdentifier (it ships
		     per-RID native libraries). Default to the host machine's RID so a
		     plain `dotnet build`/`dotnet restore` is RID-aware and portable. -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup>
		<!-- The Copilot SDK package downloads a large CLI binary and runs tar during
		     the build. The XAML designer's design-time build runs in a separate host
		     where that download can fail, which breaks reference resolution and shows
		     "Some assembly references are missing". The designer never runs the app,
		     so skip the CLI download for design-time builds only. -->
		<CopilotSkipCliDownload Condition="'$(DesignTimeBuild)' == 'true'">true</CopilotSkipCliDownload>
	</PropertyGroup>

	<ItemGroup>
		<!-- UseWindowsForms injects an implicit `using System.Windows.Forms` which
		     collides with WPF's System.Windows.Controls (ListBox, TextBox, Button).
		     Remove it; WinForms types are referenced by full qualification where needed. -->
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="GitHub.Copilot.SDK" Version="1.0.11" />
		<PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
		<PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
		<PackageReference Include="OpenAI" Version="2.13.0" />
		<!-- Mediator on-device local model hosting (Foundry Local, WinML for
		     GPU/NPU acceleration). Replaces the former Microsoft.Agents.AI
		     reference. -->
		<PackageReference Include="Microsoft.AI.Foundry.Local.WinML" Version="1.2.4" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\submodules\turboland-wpf\src\TurbolandTheme.Wpf\TurbolandTheme.Wpf.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Bundled web assets for the Rendered output tab. -->
		<None Include="web\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!-- Sample transcript shown in both output views at startup. -->
		<None Include="Assets\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows7.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<RootNamespace>TurboPilot</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<PropertyGroup>
		<!-- The Copilot SDK package downloads a large CLI binary and runs tar during
		     the build. The XAML designer's design-time build runs in a separate host
		     where that download can fail, which breaks reference resolution and shows
		     "Some assembly references are missing". The designer never runs the app,
		     so skip the CLI download for design-time builds only. -->
		<CopilotSkipCliDownload Condition="'$(DesignTimeBuild)' == 'true'">true</CopilotSkipCliDownload>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="GitHub.Copilot.SDK" Version="1.0.13-preview.2" />
		<PackageReference Include="OpenAI" Version="2.13.0" />
		<PackageReference Include="Microsoft.Agents.AI" Version="1.19.0" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\submodules\turboland-wpf\src\TurbolandTheme.Wpf\TurbolandTheme.Wpf.csproj" />
	</ItemGroup>

</Project>

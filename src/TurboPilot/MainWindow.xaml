<ctl:TurbolandWindow
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls;assembly=TurbolandTheme.Wpf"
					xmlns:local="clr-namespace:TurboPilot"
					xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
					xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="TurboPilot.MainWindow"
					Title="TURBO-PILOT"
					WindowStartupLocation="CenterScreen"
					Width="800" Height="960"
					av:DesignWidth="800" av:DesignHeight="960">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Session">
                <MenuItem Header="_New Session..." Click="OnNewSession"/>
                <MenuItem Header="_Past Sessions..."/>
                <Separator/>
                <MenuItem Header="Set_tings..." Click="OnSettings"/>
                <MenuItem Header="C_ustomization..." Click="OnCustomization"/>
                <MenuItem Header="Pe_rmissions..." Click="OnPermissions"/>
                <Separator/>
                <MenuItem Header="E_xit"/>
            </MenuItem>
            <MenuItem x:Name="menuTools" Header="_Tools">
                <MenuItem Header="Open _Powershell"/>
                <MenuItem Header="Open _Explorer"/>
                <MenuItem Header="Open _VSCode"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About..." Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Height="43">
            <StatusBarItem x:Name="statusBarItem">
                <TextBlock x:Name="statusTextBlock" Text="Start or resume a session to begin."/>
            </StatusBarItem>
            <!-- Buttons on the right side of the toolbar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                <!-- Session-dependent controls: enabled and disabled in bulk
                     by SetSessionActive, not here. No explicit colors: local
                     values would outrank the theme's disabled-state triggers
                     and leave a disabled button painted in its enabled ink. -->
                <Button x:Name="buttonAttachments" Content="+0" Width="40" Height="25" Margin="0,0,5,0" Click="ButtonAttachments_Click"/>
                <Button x:Name="buttonStop" Content="Stop" Width="60" Height="25" Margin="0,0,5,0"/>
                <Button x:Name="buttonSend" Content="Send" Width="80" Height="25"/>
            </StackPanel>
        </StatusBar>

        <!-- The blue desktop. The dialog host is a sibling laid over the content
		     in the same grid cell, so dialogs float above the output but never
		     over the menu or status bar. It is invisible and click-through
		     until a dialog is actually opened. -->
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <!-- Output tabs: takes remaining space, shrinks/grows with splitter -->
                <RowDefinition x:Name="OutputRow" Height="*"/>
                <!-- Horizontal splitter bar: draggable, minimum 4px -->
                <RowDefinition Height="4"/>
                <!-- Prompt input area: takes remaining space, shrinks/grows with splitter -->
                <RowDefinition x:Name="InputRow" Height="*"/>
            </Grid.RowDefinitions>

            <!-- Output tabs at the top (Rendered and Raw) -->
            <!-- No Style key: the theme ships an implicit TabControl and
                 TabItem style, and pointing at a key that does not exist
                 leaves the control with the stock Windows chrome. -->
            <!-- Padding 0: the theme's default TabControl padding (9,0) lets
                 the gray page background show as bars on the left and right
                 of the tab content. -->
            <TabControl Grid.Row="0" Margin="4,4,4,4" Padding="2">
                <TabItem Header="Rendered">
                    <Grid>
                        <!-- Face color is set in code from the theme table. -->
                        <wv2:WebView2 x:Name="webViewOutput" 
                        			  HorizontalAlignment="Stretch" 
                        			  VerticalAlignment="Stretch" />
                    </Grid>
                </TabItem>
                <TabItem Header="Raw">
                    <!-- Face and ink come from the theme table in code so the
                         Raw tab can never drift from the Rendered tab. -->
                    <RichTextBox x:Name="richTextBoxOutput" 
								FontFamily="{DynamicResource Turboland.Font.Primary}" 
								FontSize="16" 
								VerticalScrollBarVisibility="Auto" 
								HorizontalScrollBarVisibility="Auto" 
								IsReadOnly="True">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </TabItem>
            </TabControl>

            <!-- Horizontal resizing splitter bar (draggable Thumb) -->
            <Thumb Grid.Row="1" 
				   x:Name="SplitterThumb"
				   Cursor="SizeNS"
				   Background="#565656"
				   DragDelta="SplitterThumb_DragDelta"/>

            <!-- Prompt input area at the bottom -->
            <Grid Grid.Row="2" Margin="4,2,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- History navigation panel (left side of input area) -->
                <Border Background="#343434" BorderBrush="#565656" BorderThickness="1">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Stretch">
                        <Button x:Name="buttonHistoryPrev" 
								Content="▲" 
								Background="#343434" 
								Foreground="#949494" 
								BorderThickness="0" 
								FontFamily="Segoe UI" 
								FontSize="8" 
								Height="20" 
								VerticalAlignment="Top" 
								Click="ButtonHistoryPrev_Click"/>
                        <Button x:Name="buttonHistoryNext" 
								Content="▼" 
								Background="#343434" 
								Foreground="#949494" 
								BorderThickness="1" 
								FontFamily="Segoe UI" 
								FontSize="8" 
								Height="20" 
								VerticalAlignment="Bottom" 
								Click="ButtonHistoryNext_Click"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <RichTextBox x:Name="richTextBoxInput" 
								Background="{DynamicResource Turboland.Brush.DesktopBackground}" 
								Foreground="Yellow" 
								FontFamily="{DynamicResource Turboland.Font.Primary}" 
								FontSize="16" 
								VerticalScrollBarVisibility="Auto" 
								HorizontalScrollBarVisibility="Auto" 
								IsReadOnly="True"
								AcceptsTab="True" 
								AcceptsReturn="True">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </Grid>
            </Grid>
        </Grid>

    </DockPanel>

</ctl:TurbolandWindow>

<ctl:TurbolandWindow x:Class="TurboPilot.MainWindow"
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls;assembly=TurbolandTheme.Wpf"
					Title="TURBOPILOT"
					WindowStartupLocation="CenterScreen">

	<DockPanel>

		<Menu DockPanel.Dock="Top">
			<MenuItem Header="_File">
				<MenuItem Header="_New Session..."/>
				<MenuItem Header="_Past Sessions..."/>
				<Separator/>
				<MenuItem Header="E_xit"/>
			</MenuItem>
			<MenuItem Header="_Help">
				<MenuItem Header="_About..."/>
			</MenuItem>
		</Menu>

		<StatusBar DockPanel.Dock="Bottom">
			<StatusBarItem Content="Ready"/>
		</StatusBar>

		<GroupBox Header="Output" Margin="4">
			<TextBlock Text="TurboPilot is running." Margin="8"/>
		</GroupBox>

	</DockPanel>

</ctl:TurbolandWindow>

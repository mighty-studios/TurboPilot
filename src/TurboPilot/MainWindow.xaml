<ctl:TurbolandWindow x:Class="TurboPilot.MainWindow"
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls;assembly=TurbolandTheme.Wpf"
					Title="TURBO-PILOT"
					WindowStartupLocation="CenterScreen">

	<DockPanel>

		<Menu DockPanel.Dock="Top">
			<MenuItem Header="_File">
				<MenuItem Header="_New Session..."/>
				<MenuItem Header="_Past Sessions..."/>
				<Separator/>
				<MenuItem Header="E_xit"/>
			</MenuItem>
			<MenuItem Header="_Help">
				<MenuItem Header="_About..." Click="OnAbout"/>
			</MenuItem>
		</Menu>

		<StatusBar DockPanel.Dock="Bottom">
			<StatusBarItem Content="Ready"/>
		</StatusBar>

		<!-- The blue desktop. The dialog host is a sibling laid over the content
		     in the same grid cell, so dialogs float above the output but never
		     over the menu or status bar. It is invisible and click-through
		     until a dialog is actually opened. -->
		<Grid>
			<GroupBox Header="Output" Margin="4">
				<TextBlock Text="TurboPilot is running." Margin="8"/>
			</GroupBox>

			<ctl:TurbolandDialogHost x:Name="Dialogs"/>
		</Grid>

	</DockPanel>

</ctl:TurbolandWindow>
